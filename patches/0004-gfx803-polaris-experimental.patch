From 79f278bb7a7ec670a250a9a161ea23780fbcfefb Mon Sep 17 00:00:00 2001
From: jollyroger1480 <jollyroger1480@gmail.com>
Date: Mon, 2 Nov 2026 07:40:39 -0500
Subject: [PATCH] gfx803 (Polaris) experimental support: STRATA_HIP_GFX803
 option

- STRATA_HIP_GFX803 CMake option: dp4a byte-mad emulation (dp4a.hpp),
  wave64 MMVQ layout gates extended from GFX906 to GFX803 (native_mmvq.cu),
  iq4 table lookup via v_perm, gfx900/gfx803 on the unvalidated arch list,
  qsa_decode_attn.cu + s26_tsum.cuh excluded (need gfx10+ insts)
- mmvq_il_parity: STRATA_IL_HIP_BUILD guard for the L2 persist window +
  magnitude readout on the FAIL line (maxabs/maxrel)
- Verified on a real RX 480 through the COV4 bridge (rapier docs/BUILD.md):
  T=1 bitwise, IL arms reorder-noise only, office fast brain runs 64K ctx
  on 4 GB
---
 engine/CMakeLists.txt                      |  7 +++++++
 engine/cmake/hip_backend.cmake             |  8 +++++++-
 engine/include/strata/kernels/dp4a.hpp     | 22 ++++++++++++++++++++--
 engine/src/kernels/cuda/native_mmvq.cu     |  4 ++--
 engine/src/kernels/cuda/qsa_decode_attn.cu |  3 +++
 engine/src/kernels/cuda/s26_tsum.cuh       |  2 +-
 engine/src/kernels/mmvq_il_parity.cpp      | 12 +++++++++---
 7 files changed, 49 insertions(+), 9 deletions(-)

diff --git a/engine/CMakeLists.txt b/engine/CMakeLists.txt
index 4b2a76dd2..f94ef7413 100644
--- a/engine/CMakeLists.txt
+++ b/engine/CMakeLists.txt
@@ -102,6 +102,13 @@ if(STRATA_HIP_GFX906)
   set(STRATA_ENABLE_CUDA ON CACHE BOOL "" FORCE)
 endif()
 option(STRATA_ENABLE_HIP "Build the HIP targets for wave32 AMD GPUs (gfx1100, gfx1201; gfx1012/gfx1030 unvalidated)" OFF)
+option(STRATA_HIP_GFX803 "gfx803 (Polaris, wave64, no dp4a): dp4a byte-mad emulation, experimental" OFF)
+if(STRATA_HIP_GFX803)
+  if(NOT STRATA_ENABLE_HIP)
+    message(FATAL_ERROR "STRATA_HIP_GFX803 requires STRATA_ENABLE_HIP")
+  endif()
+  add_compile_definitions(STRATA_HIP_GFX803=1)
+endif()
 # llama.cpp's MMQ prompt kernels are no longer in the tree (0.2.16): every CUDA and HIP build compiles Strata's own prompt kernels (strata_pf_own)
 # and the FP16 path.  MMQ comparison builds come from the v0.2.15 tag.
 # The community-made AMD changes (include/strata/core/amd_community.hpp): on by default.  This option is the build half of the one
diff --git a/engine/cmake/hip_backend.cmake b/engine/cmake/hip_backend.cmake
index cec90fdbb..17ac4a782 100644
--- a/engine/cmake/hip_backend.cmake
+++ b/engine/cmake/hip_backend.cmake
@@ -12,7 +12,7 @@ endif()
 # same wave32 / 64 KiB LDS / sudot4 family as gfx1100, on a unified-memory APU; experimental.
 set(_strata_hip_validated gfx1100 gfx1201)
 set(_strata_hip_community gfx1101 gfx1200)
-set(_strata_hip_unvalidated gfx1010 gfx1011 gfx1012 gfx1102 gfx1103 gfx1030 gfx1031 gfx1032 gfx1034 gfx1150 gfx1151 gfx1152)   # gfx1103: Radeon 780M iGPU, opt-in, WMMA kernels like gfx1100; gfx1152: Krackan, Radeon 860M / 840M (#1625), builds with the portable kernels, no card report yet
+set(_strata_hip_unvalidated gfx900 gfx803 gfx1010 gfx1011 gfx1012 gfx1102 gfx1103 gfx1030 gfx1031 gfx1032 gfx1034 gfx1150 gfx1151 gfx1152)   # gfx1103: Radeon 780M iGPU, opt-in, WMMA kernels like gfx1100; gfx1152: Krackan, Radeon 860M / 840M (#1625), builds with the portable kernels, no card report yet
 # CMake hands HIP a ';' list, but a -DCMAKE_HIP_ARCHITECTURES typed by hand (or ROCm's own Windows tooling) may use
 # spaces, which foreach(IN LISTS) would otherwise treat as one element.
 string(REPLACE " " ";" _strata_hip_norm "${CMAKE_HIP_ARCHITECTURES}")
@@ -100,6 +100,12 @@ option(STRATA_GFX1012_PORTABLE_DOT "Use the portable signed-byte dot control on
 if(STRATA_GFX1012_PORTABLE_DOT)
   target_compile_definitions(strata_hip_runtime INTERFACE STRATA_GFX1012_PORTABLE_DOT=1)
 endif()
+if(STRATA_HIP_GFX803)
+  target_compile_definitions(strata_hip_runtime INTERFACE STRATA_HIP_GFX803=1)
+endif()
+if("gfx900" IN_LIST STRATA_HIP_ARCH_LIST)
+  target_compile_definitions(strata_hip_runtime INTERFACE STRATA_HIP_GFX900=1)
+endif()
 # #313: the RDNA3 WMMA GEMM's intrinsics only compile for gfx11 targets and the host pass does not define
 # __gfx11xx__, so the build supplies the macro for gfx11 configs (the kernels also gate on the device at runtime)
 if(CMAKE_HIP_ARCHITECTURES MATCHES "gfx11")
diff --git a/engine/include/strata/kernels/dp4a.hpp b/engine/include/strata/kernels/dp4a.hpp
index 5ac6047f0..33d42cc77 100644
--- a/engine/include/strata/kernels/dp4a.hpp
+++ b/engine/include/strata/kernels/dp4a.hpp
@@ -20,8 +20,8 @@
 #pragma once
 
 #include <cstdint>
-#if defined(STRATA_HIP_GFX906)
-#include <cuda_runtime.h>   // gfx906: the compat layer (__forceinline__, __nanosleep, __dp4a)
+#if defined(STRATA_HIP_GFX906) || defined(STRATA_HIP_GFX803)
+#include <cuda_runtime.h>   // gfx906/gfx803: the compat layer (__forceinline__, __nanosleep, __dp4a)
 #endif
 
 #if defined(__CUDA_ARCH__) && __CUDA_ARCH__ < 610
@@ -40,6 +40,24 @@ __device__ __forceinline__ int strata_dp4a(const int a, const int b, const int c
     return r;
 }
 #define STRATA_DP4A(a, b, c) strata_dp4a((a), (b), (c))
+#elif defined(__HIPCC__) && defined(STRATA_HIP_GFX803)
+// gfx803 (GCN4): no v_dot4 instruction - dp4a as four sign-extended byte products on
+// v_mad_i32_i24 (GCN3+), int32 wraparound accumulation: bitwise __dp4a's.
+__device__ __forceinline__ int dp4a_gfx803(const int a, const int b, const int c) {
+    // pure C++: clang lowers the sign-extended byte products to GCN4 ops (lshr/bfe + mul + add).
+    // v_mad_i32_i24 exists in the GCN4 ISA but ROCm 10's gfx803 integrated assembler rejects all
+    // VOP mnemonics (even through llvm-mc the target parses, so the asm pipeline is gutted, not
+    // the backend) - and inline asm fails through hipcc for EVERY target incl. gfx1030/gfx906.
+    int r = c;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const int ab = (int8_t) ((a >> (8 * i)) & 0xFF);
+        const int bb = (int8_t) ((b >> (8 * i)) & 0xFF);
+        r += ab * bb;
+    }
+    return r;
+}
+#define STRATA_DP4A(a, b, c) dp4a_gfx803((a), (b), (c))
 #else
 #define STRATA_DP4A(a, b, c) __dp4a((a), (b), (c))
 #endif
diff --git a/engine/src/kernels/cuda/native_mmvq.cu b/engine/src/kernels/cuda/native_mmvq.cu
index 14f05a3ce..851cc3c19 100644
--- a/engine/src/kernels/cuda/native_mmvq.cu
+++ b/engine/src/kernels/cuda/native_mmvq.cu
@@ -454,7 +454,7 @@ __device__ __align__(4) int8_t iq4nl_values[16] = {
 };
 
 __device__ __forceinline__ int2 iq4_table_lookup(int q4) {
-#if defined(STRATA_HIP_GFX906)
+#if defined(STRATA_HIP_GFX906) || defined(STRATA_HIP_GFX803)
     // AMD: llama.cpp's HIP lookup (see iq_kernels.cu get_int_from_table_16): 4 v_perm_b32 per 8 values
     const uint32_t* v32 = reinterpret_cast<const uint32_t*>(iq4nl_values);
     const uint32_t q_even = (uint32_t) q4, q_odd = (uint32_t) q4 >> 4;
@@ -2331,7 +2331,7 @@ void launch_check() {
 }
 
 
-#if defined(STRATA_HIP_GFX906)
+#if defined(STRATA_HIP_GFX906) || defined(STRATA_HIP_GFX803)
 // ---- AMD (wave64) layout: one wavefront per R rows, four wavefronts per block, the row's blocks strided over the
 // 64 lanes exactly as the CUDA kernels stride them over a block (kbx = lane / T, stride 64 / T), and a 64-lane
 // butterfly instead of the LDS partials and __syncthreads of the one-block-per-row layout: on gfx906 a block per
diff --git a/engine/src/kernels/cuda/qsa_decode_attn.cu b/engine/src/kernels/cuda/qsa_decode_attn.cu
index 410ae38a3..aba4266f6 100644
--- a/engine/src/kernels/cuda/qsa_decode_attn.cu
+++ b/engine/src/kernels/cuda/qsa_decode_attn.cu
@@ -1,3 +1,4 @@
+#if !defined(STRATA_HIP_GFX803) && !defined(STRATA_HIP_GFX900)   // QSA: the GLM indexer path - pre-dp4a/dot4 builds exclude it (permlane)
 // src/kernels/cuda/qsa_decode_attn.cu - see include/strata/kernels/qsa_decode_attn.hpp.
 #include "strata/kernels/qsa_decode_attn.hpp"
 #include "strata/core/sm75_series.hpp"
@@ -1297,3 +1298,5 @@ void qsa_decode_attn_merge_only(const int32_t* steps, int64_t cap, const QsaShap
 }
 
 }  // namespace strata::kernels
+
+#endif  // !STRATA_HIP_GFX803
diff --git a/engine/src/kernels/cuda/s26_tsum.cuh b/engine/src/kernels/cuda/s26_tsum.cuh
index f484492bd..5bbd9a855 100644
--- a/engine/src/kernels/cuda/s26_tsum.cuh
+++ b/engine/src/kernels/cuda/s26_tsum.cuh
@@ -11,7 +11,7 @@
 
 namespace strata::kernels::s26ts {
 
-#if defined(__HIP_PLATFORM_AMD__) && !defined(STRATA_HIP_GFX906)   // (permlanex16 / DPP row_xmask: gfx10+ only)
+#if defined(__HIP_PLATFORM_AMD__) && !defined(STRATA_HIP_GFX906) && !defined(STRATA_HIP_GFX803) && !defined(STRATA_HIP_GFX900)   // (permlanex16 / DPP row_xmask: gfx10+ only)
 __device__ __forceinline__ float xmov16(float v) {
     return __int_as_float(__builtin_amdgcn_permlanex16(__float_as_int(v), __float_as_int(v), 0x76543210u, 0xfedcba98u,
                                                        false, false));
diff --git a/engine/src/kernels/mmvq_il_parity.cpp b/engine/src/kernels/mmvq_il_parity.cpp
index 09e5fdbb4..09ae17fd7 100644
--- a/engine/src/kernels/mmvq_il_parity.cpp
+++ b/engine/src/kernels/mmvq_il_parity.cpp
@@ -233,16 +233,22 @@ int run_case(const Case& c, bool bench, cudaStream_t s) {
                 ck(cudaStreamSynchronize(s), "il");
                 ck(cudaMemcpy(b.data(), yil, ybytes, cudaMemcpyDeviceToHost), "read il");
                 long long diff = 0, nonfinite = 0;
+                double maxabs = 0, maxrel = 0;   // magnitude of the disagreement, not just its count
                 for (std::size_t i = 0; i < a.size(); ++i) {
-                    float fa;
+                    float fa, fb;
                     std::memcpy(&fa, &a[i], 4);
+                    std::memcpy(&fb, &b[i], 4);
                     if (!std::isfinite(fa)) ++nonfinite;
                     if (a[i] != b[i]) ++diff;
+                    const double d = std::fabs((double) fa - (double) fb);
+                    if (d > maxabs) maxabs = d;
+                    const double m = std::max(std::fabs((double) fa), 1e-30);
+                    if (d / m > maxrel) maxrel = d / m;
                 }
                 if (diff != 0 || nonfinite != 0) {
                     ++bad;
-                    std::printf("FAIL %-26s T=%d rows=%d pf=%d: %lld bits differ, %lld non-finite of %zu\n", c.name, T, r, pf, diff,
-                                nonfinite, a.size());
+                    std::printf("FAIL %-26s T=%d rows=%d pf=%d: %lld bits differ, %lld non-finite of %zu (maxabs %.3g maxrel %.3g)\n",
+                                c.name, T, r, pf, diff, nonfinite, a.size(), maxabs, maxrel);
                 }
             }
             native_mmvq_il_pf(-1);
