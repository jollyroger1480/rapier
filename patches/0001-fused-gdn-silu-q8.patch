+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "%s: %s\n", what, cudaGetErrorString(e));
+        std::exit(1);
+    }
+}
+
+void copy_dtoh(float* dst, const float* src, size_t n, const char* what) {
